# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (M2+). Secret key is server-only: never put it in frontend code.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=

# Gemini (M3+)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: used when GEMINI_MODEL is overloaded (503/429) or slow
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Gmail SMTP for relative emails (optional; email is skipped if unset)
GMAIL_USER=yourteam@gmail.com
GMAIL_APP_PASSWORD=

# Protects /api/admin/* (send as header x-admin-secret)
ADMIN_SECRET=pick-any-long-random-string
